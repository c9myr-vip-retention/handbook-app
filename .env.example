# Copy this file to .env and fill the values from your Supabase project
# (Supabase dashboard > Project Settings > API).
#
# The anon / publishable key is designed to be public and ships in the browser.
# It is NOT a secret. Row-Level Security (RLS) in schema.sql is the real
# security wall. Never put the service_role key in this file or the app.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
