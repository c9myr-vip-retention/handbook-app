{
  "name": "handbook-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "C9MYR VIP Retention Handbook app. React + Vite front end; Cloudflare Pages + D1 + Access back end.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-public.mjs",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --d1 DB=handbook --compatibility-date=2026-01-01",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=c9myr-rtn-handbook --branch=main",
    "sync": "node db/sync.mjs",
    "export": "node db/export.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "exceljs": "^4.4.0",
    "vite": "^5.4.0",
    "wrangler": "^3.80.0"
  }
}
